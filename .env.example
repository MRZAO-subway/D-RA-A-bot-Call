# Discord Bot Token (REQUIRED)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Voice Channel ID (REQUIRED)
# Right-click the voice channel > Copy Channel ID
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Auto-reconnect delay in milliseconds (OPTIONAL, default: 5000)
RECONNECT_DELAY=5000

# Log level: debug | info | warn | error (OPTIONAL, default: info)
LOG_LEVEL=info
